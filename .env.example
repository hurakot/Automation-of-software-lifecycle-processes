# Локальный Compose; заменить значения REPLACE_ME перед запуском.
POSTGRES_USER=conf_user
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=conference
SECRET_KEY=REPLACE_ME

# Только для запуска Python на хосте; Compose собирает свой URL с хостом db.
# PostgreSQL должен быть доступен на localhost:5432 отдельно от корневого Compose.
DATABASE_URL=postgresql://conf_user:REPLACE_ME@localhost:5432/conference

# Для deploy/stage и deploy/prod: указать свой репозиторий образов и тег.
# APP_IMAGE=your-account/conference-app
# APP_TAG=your-release-tag
